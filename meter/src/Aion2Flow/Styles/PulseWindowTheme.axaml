<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Cloris.Aion2Flow.Styles.PulseWindowTheme">
  <Style Selector="Button">
    <Setter Property="Background" Value="#202A36" />
    <Setter Property="Foreground" Value="#EDF3F8" />
    <Setter Property="BorderBrush" Value="#303E4D" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button:pointerover"><Setter Property="Background" Value="#2A3A49" /></Style>
  <Style Selector="Button.PulseNav"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="MinHeight" Value="38" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="Button.PulseNav.selected"><Setter Property="Background" Value="#253341" /></Style>
  <Style Selector="ComboBox, NumericUpDown, TextBox"><Setter Property="Background" Value="#18212C" /><Setter Property="Foreground" Value="#EDF3F8" /><Setter Property="BorderBrush" Value="#303E4D" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="CheckBox"><Setter Property="FontSize" Value="12" /></Style>
</Styles>
